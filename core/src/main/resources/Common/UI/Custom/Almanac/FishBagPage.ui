$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 520, Height: 480);

  #Title {
    Label #BagTitle {
      Style: (
        ...$C.@TitleStyle,
        HorizontalAlignment: Center
      );
      Padding: (Horizontal: 19);
      Text: "Fish Market";
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Horizontal: 10);

    Group #FishGridContainer {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Top: 10, Left: 8, Right: 8);

      Group #FishGrid {
        LayoutMode: LeftCenterWrap;
      }
    }


    Group #Footer {

      Anchor: (Height: 60);
      LayoutMode: CenterMiddle;
      Padding: (Bottom: 8, Top: 8);

      $C.@TextButton #SellAllButton {
        Anchor: (Width: 180, Height: 40);
        Text: "Sell All Fish";
      }
    }
  }
}

$C.@BackButton {}